# Elasticsearch and Redis may be Docker service names or remote hosts.
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http
ES_INDEX=products_v2
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# NER and cache-version dimensions.
NER_MODE=hybrid
NER_MODEL_ENABLED=false
NER_MODEL_VERSION=none
NER_MODEL_DIR=/srv/ai-search/models/ner
SEARCH_INDEX_VERSION=products-v1
SEARCH_DICT_VERSION=dict-v1
SEARCH_NER_MODEL_VERSION=none
SEARCH_RULE_VERSION=rules-v1

# Application images; CI replaces these with immutable sha-<commit> tags.
AI_SEARCH_REST_IMAGE=ai-search-rest:1.0.0
FRONTEND_IMAGE=ai-search-frontend:1.0.0
GATEWAY_IMAGE=ai-search-gateway:1.0.0
ELASTICSEARCH_IMAGE=ai-search-elasticsearch:8.12.0
REDIS_IMAGE=redis:7-alpine
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.12.0
LABEL_STUDIO_IMAGE=heartexlabs/label-studio:1.23.0

# Shared network and host directories for Ubuntu deployments.
AI_SEARCH_SHARED_NETWORK=ai-search-shared
ES_DATA_DIR=/srv/ai-search/data/elasticsearch
REDIS_DATA_DIR=/srv/ai-search/data/redis
LABEL_STUDIO_DATA_DIR=/srv/ai-search/data/label-studio
LABEL_STUDIO_FILES_DIR=/srv/ai-search/data/label-studio-files
FILE_SERVICE_DATA_DIR=/srv/ai-search/data/files
AI_SEARCH_REST_LOG_DIR=/srv/ai-search/logs/rest
NGINX_LOG_DIR=/srv/ai-search/logs/nginx
NGINX_HTPASSWD_FILE=/srv/ai-search/credentials/nginx.htpasswd

# Loopback-only administration endpoints.
ES_TUNNEL_BIND_ADDRESS=127.0.0.1
ES_TUNNEL_PORT=19200
REDIS_TUNNEL_BIND_ADDRESS=127.0.0.1
REDIS_TUNNEL_PORT=16379
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080
KIBANA_PUBLIC_URL=http://localhost:18080/kibana
LABEL_STUDIO_HOST=http://localhost:18080/label-studio
LABEL_STUDIO_CSRF_TRUSTED_ORIGINS=http://localhost:18080

# Resource limits.
ES_JAVA_OPTS=-Xms2g -Xmx2g
ES_MEMORY_LIMIT=4g
REDIS_MEMORY_LIMIT=768m
KIBANA_MEMORY_LIMIT=1536m
LABEL_STUDIO_MEMORY_LIMIT=1536m
FILE_SERVICE_MEMORY_LIMIT=256m
FILE_SERVICE_MAX_UPLOAD_BYTES=1073741824
AI_SEARCH_REST_JAVA_OPTS=-Xms384m -Xmx768m -XX:+UseG1GC
AI_SEARCH_REST_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=128m
GATEWAY_MEMORY_LIMIT=128m

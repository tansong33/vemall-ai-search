# Public URL used by Label Studio to generate links when it is behind Nginx.
LABEL_STUDIO_HOST=https://ai-search.tsong.xyz/label-studio
LABEL_STUDIO_CSRF_TRUSTED_ORIGINS=https://ai-search.tsong.xyz,http://127.0.0.1:18080,http://localhost:18080
KIBANA_PUBLIC_URL=https://ai-search.tsong.xyz/kibana

# Gateway stays on loopback. TLS/VPN/Cloudflare Tunnel should be the only
# externally reachable entry. Do not set this to 0.0.0.0 without a firewall.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080

# Host directories. Replace these with /srv/ai-search/... on Linux.
ES_DATA_DIR=E:/ai-search-data/elasticsearch
REDIS_DATA_DIR=E:/ai-search-data/redis
LABEL_STUDIO_DATA_DIR=E:/label-studio-data
FILE_SERVICE_DATA_DIR=E:/ai-search-data/files
NER_MODEL_DIR=E:/ai-search-data/ner/models/production
BACKEND_LOG_DIR=E:/ai-search-next-data/logs/backend
NGINX_LOG_DIR=E:/ai-search-next-data/logs/nginx
KIBANA_ENV_FILE=E:/ai-search-data/credentials/kibana.env
NGINX_HTPASSWD_FILE=E:/ai-search-data/credentials/nginx.htpasswd

# 1 GiB per uploaded file; Nginx allows up to 2 GiB per request.
FILE_SERVICE_MAX_UPLOAD_BYTES=1073741824

# Shared development endpoints are loopback-only and should be reached through
# SSH tunnels. Never expose unauthenticated Elasticsearch or Redis publicly.
ES_TUNNEL_BIND_ADDRESS=127.0.0.1
ES_TUNNEL_PORT=19200
REDIS_TUNNEL_BIND_ADDRESS=127.0.0.1
REDIS_TUNNEL_PORT=16379

# Per-environment isolation when multiple app stacks share ES and Redis.
ES_INDEX=products_v2
REDIS_DATABASE=0

# LLM fallback. The API key is a real credential and must NEVER be committed:
# keep it in /etc/ai-search/prod.env or the CI secret store, not here.
LLM_ENABLED=false
LLM_PROVIDER=<provider>
LLM_BASE_URL=<https://api.example.com/v1>
LLM_MODEL=<model-id>
LLM_API_KEY=<injected-at-runtime>
LLM_TIMEOUT_MS=3000
# Trigger thresholds. Confidence must match decode.tau_accept in ner_manifest.json.
LLM_TRIGGER_MIN_RESULTS=3
LLM_TRIGGER_MIN_CONFIDENCE=0.60
# Cost controls: per-user/min, global/min, cache TTL in seconds.
LLM_RATE_LIMIT_USER=5
LLM_RATE_LIMIT_GLOBAL=100
LLM_CACHE_TTL_SECONDS=3600
# Async analysis queue (reuses the shared Redis, no extra middleware).
LLM_ASYNC_ENABLED=false
LLM_ASYNC_STREAM=llm_analysis_tasks

# Application image references used by compose.apps.yml. CI can replace these
# with immutable ghcr.io/...:<commit-sha> tags.
BACKEND_IMAGE=ai-search-next-backend:2.0.0
FRONTEND_IMAGE=ai-search-next-frontend:2.0.0
GATEWAY_IMAGE=ai-search-next-gateway:2.0.0

# Shared images are also published by CI, but are upgraded only in a planned
# maintenance window after a backup.
ELASTICSEARCH_IMAGE=ai-search-next-elasticsearch:8.12.0
FILE_SERVICE_IMAGE=ai-search-next-file-service:1.0.0

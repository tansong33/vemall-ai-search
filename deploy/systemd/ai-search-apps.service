[Unit]
Description=Vemall AI Search application stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-search
ExecStart=/usr/bin/docker compose -p ai-search-prod --env-file /etc/ai-search/prod.env -f /opt/ai-search/compose.apps.yml up -d --no-build
ExecStop=/usr/bin/docker compose -p ai-search-prod --env-file /etc/ai-search/prod.env -f /opt/ai-search/compose.apps.yml stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Mall canonical NER record",
  "type": "object",
  "required": ["query_id", "text", "group_id", "source", "entities"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "quality_level": {"enum": ["gold", "silver", "bronze"]},
    "review_status": {"type": "string"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "text", "label"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "label": {
            "enum": ["CATEGORY", "BRAND", "PRODUCT_TYPE", "SCENE", "ATTRIBUTE_VALUE"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

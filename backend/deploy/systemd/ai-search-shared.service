[Unit]
Description=Vemall AI Search shared infrastructure
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ai-search
ExecStart=/usr/bin/docker compose --profile admin --env-file /etc/ai-search/shared.env -f /opt/ai-search/compose.shared.yml up -d --no-build
ExecStop=/usr/bin/docker compose --profile admin --env-file /etc/ai-search/shared.env -f /opt/ai-search/compose.shared.yml stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target

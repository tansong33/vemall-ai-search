<!-- 加到你现有 Spring Boot 项目的 pom.xml。ONNX Runtime 和 DJL tokenizer 都带原生库，
     体积约 200MB；如果嫌大，可以只在需要的部署单元里引入。 -->
<dependencies>
  <!-- ONNX 推理。GPU 机器换成 onnxruntime_gpu，API 完全一致 -->
  <dependency>
    <groupId>com.microsoft.onnxruntime</groupId>
    <artifactId>onnxruntime</artifactId>
    <version>1.24.0</version>
  </dependency>

  <!-- HuggingFace tokenizer 的 Java 绑定：直接读 tokenizer.json，且能给出字符 offset。
       自己用 Java 重写 WordPiece 是这个项目最容易踩的坑，不要做。 -->
  <dependency>
    <groupId>ai.djl.huggingface</groupId>
    <artifactId>tokenizers</artifactId>
    <version>0.36.0</version>
  </dependency>

  <dependency>
    <groupId>com.fasterxml.jackson.core</groupId>
    <artifactId>jackson-databind</artifactId>
  </dependency>

  <dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter</artifactId>
    <scope>test</scope>
  </dependency>
</dependencies>

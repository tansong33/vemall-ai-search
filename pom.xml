<?xml version="1.0" encoding="UTF-8"?>
<!-- AI 智能搜索 - 临时父 POM，待接入公司正式父 POM -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.vetech.ai</groupId>
    <artifactId>ai-search-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>AI Search Parent</name>
    <description>AI 智能搜索 - 公司父工程多模块聚合（临时父 POM，待接入公司正式父 POM）</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <modules>
        <module>ai-search-fccapi</module>
        <module>ai-search-feign</module>
        <module>ai-search-server</module>
        <module>ai-search-rest</module>
        <module>ai-search-scheduled</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>

        <!-- 依赖版本集中管理 -->
        <elasticsearch.version>7.17.15</elasticsearch.version>
        <okhttp.version>4.12.0</okhttp.version>
        <fastjson2.version>2.0.47</fastjson2.version>
        <onnxruntime.version>1.26.0</onnxruntime.version>
        <ahocorasick.version>0.6.3</ahocorasick.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>
    </properties>

    <!-- 所有子模块共享的依赖版本管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- 项目内模块 -->
            <dependency>
                <groupId>cn.vetech.ai</groupId>
                <artifactId>ai-search-fccapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.vetech.ai</groupId>
                <artifactId>ai-search-feign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.vetech.ai</groupId>
                <artifactId>ai-search-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.vetech.ai</groupId>
                <artifactId>ai-search-scheduled</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Elasticsearch -->
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>

            <!-- HTTP -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- JSON -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- ML/AI -->
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>

            <!-- NER -->
            <dependency>
                <groupId>org.ahocorasick</groupId>
                <artifactId>ahocorasick</artifactId>
                <version>${ahocorasick.version}</version>
            </dependency>

            <!-- MySQL -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
